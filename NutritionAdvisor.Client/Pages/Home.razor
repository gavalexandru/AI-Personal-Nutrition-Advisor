@page "/"
@using NutritionAdvisor.Client.Auth
@using NutritionAdvisor.Application.Profiles.DTOs
@using NutritionAdvisor.Domain.Enums
@inject HttpClient Http
@inject NavigationManager NavManager
@inject CookieAuthStateProvider AuthStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="profile-container">
    <div class="profile-header d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div class="mb-3 mb-md-0">
            <h2 class="mb-1">Welcome back, @_userName! 👋</h2>
            <p class="text-muted m-0">
                Current Plan: <span class="badge @(_isPremium ? "bg-warning text-dark" : "bg-secondary")">
                    @(_isPremium ? "⭐ PREMIUM" : "FREE")
                </span>
            </p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            @if (!_isPremium)
            {
                <button @onclick="GoPremium" class="btn btn-warning fw-bold d-flex align-items-center gap-2 shadow-sm">
                    ⭐ Upgrade to Premium
                </button>
            }
            <a href="/user-profile" class="btn btn-outline-dark d-flex align-items-center gap-2">
                👤 My Profile
            </a>
            <button @onclick="HandleLogout" class="btn btn-outline-danger d-flex align-items-center gap-2">
                Logout
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Action Denied!</strong> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-4 gap-3">
        <h3 class="profile-section-title m-0">🍽️ Your Meal Plan</h3>
        
        @if (_planDays.Any() && !_isLoading && !_isGenerating)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary" @onclick="() => GeneratePlan(PlanType.Daily)">
                    🔄 Regenerate 1 Day
                </button>
                @if (_isPremium)
                {
                    <button class="btn btn-primary" @onclick="() => GeneratePlan(PlanType.Weekly)">
                        🔄 Regenerate 7 Days
                    </button>
                }
            </div>
        }
    </div>

    @if (_isLoading || _isGenerating)
    {
        <div class="text-center py-5">
            <span class="spinner-border text-success" style="width: 3rem; height: 3rem;"></span>
            <h5 class="mt-3 text-muted">@(_isGenerating ? "Generating your AI meal plan. This might take a moment..." : "Loading...")</h5>
        </div>
    }
    else if (_planDays.Any())
    {
        @foreach (var day in _planDays)
        {
            <div class="mb-5">
                <h4 class="fw-bold text-secondary mb-3 border-bottom pb-2">📅 Day @day.Day</h4>
                
                <div class="row g-4 align-items-stretch">
                    @foreach (var meal in day.Meals)
                    {
                        <div class="col-12 col-md-6">
                            <div class="meal-card p-4 h-100 d-flex flex-column border rounded shadow-sm bg-white">
                                <div class="mb-auto">
                                    <span class="meal-badge fw-bold text-uppercase text-primary small">@meal.MealType</span>
                                    <h5 class="fw-bold mt-2">@meal.Name</h5>
                                    <p class="text-muted small">@meal.Description</p>
                                </div>
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between mb-3 text-muted small fw-bold">
                                        <span>🥩 @meal.Protein g</span>
                                        <span>🥑 @meal.Fat g</span>
                                        <span>🍞 @meal.Carbs g</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                        <span class="fw-bold text-success fs-5">@meal.Calories kcal</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-light text-center border py-5 shadow-sm">
            <h4 class="fw-bold mb-3">No Active Meal Plan</h4>
            <p class="text-muted mb-4">You don't have a meal plan generated yet.</p>
            <div class="d-flex justify-content-center gap-3">
                <button class="btn btn-outline-success" @onclick="() => GeneratePlan(PlanType.Daily)">
                    Generate Daily Plan
                </button>
                @if (_isPremium)
                {
                    <button class="btn btn-success" @onclick="() => GeneratePlan(PlanType.Weekly)">
                        Generate Weekly Plan
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    private string _userName = "User";
    private bool _isPremium = false;
    private string? _errorMessage;
    
    private List<MealPlanDayDto> _planDays = [];
    private bool _isLoading = true;
    private bool _isGenerating = false;

    public class MealPlanDayDto
    {
        public int Day { get; set; }
        public List<MealDto> Meals { get; set; } = [];
    }

    public class MealDto
    {
        public string MealType { get; set; } = ""; 
        public string Name { get; set; } = "";     
        public string Description { get; set; } = "";
        public double Calories { get; set; }
        public double Protein { get; set; }
        public double Fat { get; set; }
        public double Carbs { get; set; }
    }

    public class CheckoutResponse 
    { 
        public string Url { get; set; } = ""; 
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userName = authState.User.Identity?.Name ?? "User";

        await LoadUserInfo();
        await LoadCurrentPlan();
    }

    private async Task LoadUserInfo()
    {
        try
        {
            var info = await Http.GetFromJsonAsync<PersonalInfoDto>("api/profile/personal-info");
            if (info != null)
            {
                _isPremium = info.Subscription == SubscriptionType.Premium;
            }
        }
        catch { }
    }

    private async Task LoadCurrentPlan()
    {
        _isLoading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<List<MealPlanDayDto>>("api/dashboard/current-plan");
            if (response != null)
            {
                foreach(var day in response)
                {
                    day.Meals = day.Meals.OrderBy(m => GetMealSortOrder(m.MealType)).ToList();
                }
                _planDays = response;
            }
        }
        catch { _planDays = []; }
        _isLoading = false;
        StateHasChanged();
    }

    private static int GetMealSortOrder(string mealType) => mealType?.ToLower() switch
    {
        "breakfast" => 1, "lunch" => 2, "snack" => 3, "dinner" => 4, _ => 5
    };

    private async Task GeneratePlan(PlanType type)
    {
        _errorMessage = null;
        _isGenerating = true;
        StateHasChanged(); 

        var response = await Http.PostAsJsonAsync("api/dashboard/generate-plan", type);
        if (response.IsSuccessStatusCode)
        {
            await LoadCurrentPlan();
        }
        else
        {
            // Extragem eroarea (cea setată în Backend cu "throw new Exception(...)")
            var errorResult = await response.Content.ReadAsStringAsync();
            _errorMessage = errorResult;
            
            // Daca raspunsul API-ului contine JSON cu detalii de eroare default, curatam mesajul:
            if (_errorMessage.Contains("Premium")) _errorMessage = "Weekly plans are for Premium users only.";
            if (_errorMessage.Contains("1 plan per day")) _errorMessage = "Free users can only generate 1 plan per day. Upgrade to Premium!";
        }
        
        _isGenerating = false;
        StateHasChanged();
    }

    private async Task GoPremium()
    {
        try
        {
            var response = await Http.PostAsync("api/payments/create-checkout", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CheckoutResponse>();
                if (result != null && !string.IsNullOrEmpty(result.Url))
                {
                    NavManager.NavigateTo(result.Url, forceLoad: true);
                }
            }
        }
        catch { }
    }

    private async Task HandleLogout()
    {
        await Http.PostAsync("api/auth/logout", null);
        AuthStateProvider.NotifyUserLogout();
        NavManager.NavigateTo("/login");
    }
}