<div class="top-row ps-3 navbar navbar-light border-bottom">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-dark" href="">🥑 Nutrition AI</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column mt-3">
        
        <div class="nav-item px-3">
            <NavLink class="nav-link text-dark" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu text-success" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link text-dark" href="profile">
                <span class="bi bi-person-badge-fill-nav-menu text-success" aria-hidden="true"></span> My Profile
            </NavLink>
        </div>

    </nav>
</div>

@code {
    private bool _collapseNavMenu = true;

    private string? NavMenuCssClass => _collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        _collapseNavMenu = !_collapseNavMenu;
    }
}